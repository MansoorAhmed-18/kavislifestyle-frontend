# Kavi's Lifestyle - Server Environment Variables

# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5174
PUBLIC_SITE_URL=http://localhost:5173

# Supabase Credentials (Obtain from Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-keep-secret

# Razorpay Payment Gateway (Obtain from Razorpay Dashboard > Settings > API Keys)
# Test mode keys start with: rzp_test_
# Live mode keys start with: rzp_live_
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email Notifications (Optional: Resend API)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=orders@kavislifestyle.com
