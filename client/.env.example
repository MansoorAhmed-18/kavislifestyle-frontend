# Kavi's Lifestyle - Frontend Environment Configuration
# Obtain your Supabase credentials from your Supabase Project Settings > API
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API Base URL (Local: http://localhost:5000/api)
VITE_API_BASE_URL=http://localhost:5001/api

# Razorpay Key ID (Obtain from Razorpay Dashboard > Settings > API Keys)
# Format: rzp_test_... or rzp_live_...
VITE_RAZORPAY_KEY_ID=rzp_test_sample_key
